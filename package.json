{
  "name": "reign-of-grelok-ts",
  "version": "1.0.0",
  "description": "This is a small adventure game written in Typescript. It is a rewrite of [Fallout 3 Easter Egg](http://fallout.wikia.com/wiki/Reign_of_Grelok). You play as Grognak, a mighty barbarian, and your goal is to put an end to the terrible reign of Grelok, an evil wizard.",
  "homepage": "https://github.com/lstejskal/reign-of-grelok-ts#readme",
  "bugs": {
    "url": "https://github.com/lstejskal/reign-of-grelok-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lstejskal/reign-of-grelok-ts.git"
  },
  "license": "ISC",
  "author": "Lukas Stejskal",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsc-watch --onSuccess \"node dist/index.js\"",
    "play": "tsc && node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "tsc-watch": "^7.2.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "js-yaml": "^5.4.2"
  }
}
